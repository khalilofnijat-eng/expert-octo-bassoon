# Copy to .env (never commit .env) and fill in real values locally.
# Placeholder names only: no real values belong in this file.

# Avito API credentials (docs/INTEGRATIONS.md, BLOCKERS.md B-007)
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
# Optional: numeric Avito account id; the access check reads it from accounts/self when unset.
AVITO_USER_ID=

# Secrets file (T-039): on Windows the default is %LOCALAPPDATA%\AvitoAssistant\secrets.env,
# written by scripts/windows/setup-avito-credentials.ps1. It must be outside this repository,
# any other git working tree and the Obsidian vault. Uncomment only to override:
# ASSISTANT_SECRETS_FILE=C:\path\outside\repo\and\vault\secrets.env
# ASSISTANT_SECRETS_FILE=none   # disable the secrets file (tests)

# PostgreSQL connection string, e.g. postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Absolute path for live data (DB files, raw Avito data, photo cache).
# Must be outside the git repository and outside the Obsidian vault (docs/DECISIONS.md D-008).
DATA_DIR=

# draft_only (default) | approve_to_send  (docs/DECISIONS.md D-006, D-016)
AUTOMATION_MODE=draft_only

# production (default; unset/unknown also means production) | development | test — synthetic data only outside production
APP_ENV=production
