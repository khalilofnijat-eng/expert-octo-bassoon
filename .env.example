# Copy to .env (never commit .env) and fill in real values locally.
# Placeholder names only: no real values belong in this file.

# Avito API credentials (docs/INTEGRATIONS.md, BLOCKERS.md B-007)
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# PostgreSQL connection string, e.g. postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Absolute path for live data (DB files, raw Avito data, photo cache).
# Must be outside the git repository and outside the Obsidian vault (docs/DECISIONS.md D-008).
DATA_DIR=

# draft_only (default) | approve_to_send | auto_scoped  (docs/DECISIONS.md D-006)
AUTOMATION_MODE=draft_only

# production (default; unset/unknown also means production) | development | test — synthetic data only outside production
APP_ENV=production
